#!/bin/sh
# XDG autostart + manual launcher for the tray icon (installed runtime copy).
export GI_TYPELIB_PATH="$HOME/.local/lib/girepository-1.0"
export PYTHONUNBUFFERED=1
export NO_AT_BRIDGE=1
export XDG_CURRENT_DESKTOP=ubuntu:GNOME
exec /usr/bin/python3 "$HOME/.local/lib/proton-drive-sync/tray/proton-drive-sync-tray.py"
