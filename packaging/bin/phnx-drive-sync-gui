#!/bin/sh
# Launcher for the PHNX Drive Sync file manager GUI (installed runtime copy).
# GTK4 + Libadwaita typelibs are provided by the distro packages install.sh pulls in.
LIB="${PHNX_DRIVE_SYNC_LIBDIR:-${DRIVE_SYNC_LIBDIR:-$HOME/.local/lib/phnx-drive-sync}}"
PY="$(command -v python3 2>/dev/null || command -v python 2>/dev/null)"
if [ -z "$PY" ]; then
    echo "phnx-drive-sync-gui: python3 not found" >&2
    exit 1
fi
exec "$PY" "$LIB/gui/phnx-drive-sync-gui.py" "$@"
