#!/bin/sh
# Launcher for the PHNX Drive Sync tray icon (installed runtime copy).
# The AppIndicator typelib is provided by the distro package install.sh pulls in.
PY="$(command -v python3 2>/dev/null || command -v python 2>/dev/null)"
if [ -z "$PY" ]; then
    echo "phnx-drive-sync-tray: python3 not found" >&2
    exit 1
fi
# a user-local AppIndicator typelib (~/.local/lib/girepository-1.0) is used when
# present (distros that lack the gir package); the system typelib is used otherwise
if [ -d "$HOME/.local/lib/girepository-1.0" ]; then
    GI_TYPELIB_PATH="$HOME/.local/lib/girepository-1.0${GI_TYPELIB_PATH:+:$GI_TYPELIB_PATH}"
    export GI_TYPELIB_PATH
fi
# a user-level AppIndicator implementation library (fetched by install.sh when
# the system package is unavailable) is found through LD_LIBRARY_PATH
if [ -e "$HOME/.local/lib/libayatana-appindicator3.so.1" ] || [ -e "$HOME/.local/lib/libappindicator3.so.1" ]; then
    LD_LIBRARY_PATH="$HOME/.local/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
    export LD_LIBRARY_PATH
fi
exec "$PY" "$HOME/.local/lib/phnx-drive-sync/tray/phnx-drive-sync-tray.py"
