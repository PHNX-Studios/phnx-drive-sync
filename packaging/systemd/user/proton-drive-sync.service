[Unit]
Description=Proton Drive Sync engine (bidirectional sync with Proton Drive)
Documentation=file:%h/.local/lib/proton-drive-sync/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# runtime code lives on the internal disk (~/.local/lib/proton-drive-sync, installed
# by packaging/install.sh) so login start never waits for the external SSD
ExecStart=%h/.local/lib/proton-drive-sync/proton-drive-sync.sh run
# belt & braces: never leave a FUSE session mounted if the engine dies hard
ExecStopPost=-/usr/bin/fusermount3 -u "%h/Proton Drive"
# no periodic full walk: one full walk runs at startup, then the inotify watcher
# and the SDK event stream drive incremental passes (Sync now on demand via SIGUSR1)
Restart=on-failure
RestartSec=10
TimeoutStopSec=15
KillSignal=SIGTERM

[Install]
WantedBy=default.target
