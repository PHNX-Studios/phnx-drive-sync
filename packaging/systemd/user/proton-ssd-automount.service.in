[Unit]
Description=Mount the storage SSD (automount; convenience for the dev checkout on ~/Projects)
# GNOME/udisks only automounts a drive when it appears *after* login — a drive
# already attached at session start waits for a user to open it in Files.
# This closes that gap without root. If the drive is simply unplugged the unit
# stays inactive (condition fails, no restart loop).
ConditionPathExists=/dev/disk/by-uuid/@SSD_UUID@

[Service]
Type=oneshot
RemainAfterExit=yes
# idempotent: fails harmlessly if already mounted or absent; retry covers the
# race where udisks is not ready yet at early session start
ExecStart=/bin/sh -c 'until /usr/bin/findmnt -n /dev/disk/by-uuid/@SSD_UUID@ >/dev/null 2>&1 || /usr/bin/udisksctl mount -b /dev/disk/by-uuid/@SSD_UUID@ >/dev/null 2>&1; do sleep 2; done'
ExecStop=-/usr/bin/udisksctl unmount -b /dev/disk/by-uuid/@SSD_UUID@
TimeoutStartSec=60

[Install]
WantedBy=default.target
