[Unit]
Description=PHNX Drive Sync tray icon (unofficial)
Documentation=file:%h/.local/lib/phnx-drive-sync/README.md
PartOf=graphical-session.target
After=graphical-session.target
BindsTo=graphical-session.target

[Service]
Type=simple
Environment=PATH=/usr/bin:/bin:/usr/local/bin
Environment=HOME=%h
Environment=XDG_RUNTIME_DIR=/run/user/%U
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%U/bus
Environment=PYTHONUNBUFFERED=1
Environment=NO_AT_BRIDGE=1
# DISPLAY/WAYLAND_DISPLAY are intentionally NOT set here: hardcoding them
# overrides the real graphical session and breaks non-:0 / pure-Wayland setups.
# The user manager imports the session environment; the XDG autostart entry is
# the primary tray launcher regardless.
ExecStart=%h/.local/bin/phnx-drive-sync-tray
Restart=on-failure
RestartSec=2
TimeoutStopSec=10
Slice=session.slice

[Install]
WantedBy=graphical-session.target
